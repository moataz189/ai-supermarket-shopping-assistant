# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Coverage
.coverage
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/

# Databases
*.db

# Environment
.env

# Node
node_modules/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.auto.tfvars
*.tfvars
!infra/tf/tfvars/*.tfvars
!infra/tf-il/tfvars/*.tfvars

# Packer
infra/packer/packer_cache/
*.pkrvars.hcl
packer-manifest.json

# Kubernetes cluster access (never commit — SSH into the control plane or use
# scripts/bootstrap.sh's own kubeconfig at /etc/kubernetes/admin.conf instead)
kubeconfig*
*.pem

# Git worktrees
.worktrees/
worktrees/

# Retailer login sessions (live cookies — never commit, never baked into an image; synced
# to Kubernetes Secrets from GitHub Secrets by .github/workflows/sync-retailer-sessions.yml)
sessions/
*.session.json
