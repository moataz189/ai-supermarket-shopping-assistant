# --- Shared across local (non-Docker) and docker-compose runs ---
DATABASE_URL=sqlite:///./app.db
BEDROCK_MODEL_ID=openai.gpt-oss-20b-1:0
AWS_REGION=us-east-1
SPOONACULAR_API_KEY=changeme

# --- docker-compose only ---
# Read by docker-compose.yml directly (${VAR} interpolation); harmless to leave set when
# running the backend locally with `make run` too, since app/agent/mcp_clients.py already
# defaults each *_MCP_URL to localhost if unset.
# SUPERMARKET_MCP_URL=http://supermarket-mcp:8001/mcp
# RECIPE_MCP_URL=http://recipe-mcp:8002/mcp
# RETAILER_CART_MCP_URL=http://retailer-cart-mcp:8003/mcp
